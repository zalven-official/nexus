    "@vueuse/core": "^10.10.0",
    "btoa": "^1.2.1",
    "buffer": "^6.0.3",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "lucide-vue-next": "^0.379.0",
